# Copy to .env.local and fill in. Never commit real secrets.

# -----------------------------------------------------
# Supabase
# -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional alternative to the anon key (newer Supabase projects)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Service role key — SERVER ONLY. Used for billing writes and payment callbacks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------
# Site
# -----------------------------------------------------
# Public base URL, no trailing slash. M-Pesa callbacks require a public HTTPS
# URL — for local development use a tunnel (e.g. ngrok) and put its URL here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rent paybill shown to tenants (M-Pesa). Equity Bank's paybill is 247247.
# Tenants pay with account number CODE#UNIT, e.g. VIV#A1, where CODE is the
# property's "Equity Payment Code" set on the property.
NEXT_PUBLIC_PAYBILL_NUMBER=247247
NEXT_PUBLIC_PAYBILL_ACCOUNT_NAME=Equity Bank

# -----------------------------------------------------
# M-Pesa Daraja (subscription payments via STK Push)
# https://developer.safaricom.co.ke
# -----------------------------------------------------
# 'sandbox' (default) or 'production'
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# Sandbox shortcode is 174379. In production: your Paybill number, or for a
# till, the HEAD OFFICE / store number that owns the till.
MPESA_SHORTCODE=174379
# Lipa Na M-Pesa Online passkey. For sandbox use the public test passkey from
# the Daraja docs/simulator; production passkey is emailed by Safaricom on go-live.
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
# 'CustomerPayBillOnline' (Paybill, default) or 'CustomerBuyGoodsOnline' (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional. Receiving party; defaults to MPESA_SHORTCODE. Set to the till number for Buy Goods.
MPESA_PARTY_B=
# Random secret appended to the callback URL (?token=...) — Daraja does not
# sign callbacks. Generate with: openssl rand -hex 32
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------
# Paystack (card + mobile money checkout, KES)
# https://dashboard.paystack.com/#/settings/developers
# Webhook URL to configure in the dashboard:
#   ${NEXT_PUBLIC_SITE_URL}/api/billing/paystack/webhook
# -----------------------------------------------------
# sk_test_... for test mode, sk_live_... for production
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------
# Equity Bank rent collection (Finserve Jenga API v3)
# https://developer.jengahq.io  — keys from Jenga HQ > Settings > API Keys
# -----------------------------------------------------
# 'sandbox' (default) or 'production'
JENGA_ENV=sandbox
JENGA_API_KEY=your-jenga-api-key
JENGA_MERCHANT_CODE=your-merchant-code
JENGA_CONSUMER_SECRET=your-consumer-secret
# RSA private key whose public key is uploaded to Jenga HQ. Put it on one line
# with 
 for line breaks. Generate with:
#   openssl genrsa -out privatekey.pem 2048
#   openssl rsa -in privatekey.pem -outform PEM -pubout -out publickey.pem
JENGA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# The Equity account rent is paid into, and its country
EQUITY_ACCOUNT_NUMBER=0000000000000
EQUITY_COUNTRY_CODE=KE
# Secret appended to the IPN URL you register in Jenga HQ:
#   ${NEXT_PUBLIC_SITE_URL}/api/payments/equity/ipn?token=${EQUITY_IPN_SECRET}
# Generate with: openssl rand -hex 32
EQUITY_IPN_SECRET=change-me-to-a-long-random-string
# Protects GET /api/payments/equity/sync (statement backstop). Call it on a
# schedule with header "Authorization: Bearer ${CRON_SECRET}".
CRON_SECRET=change-me-to-another-long-random-string
